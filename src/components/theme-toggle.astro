---
import { Icon } from 'astro-icon/components';
---

<!--
  Hidden SVG that defines symbols first so <use> references always resolve,
  even when the "real" icon elements are display:none.
-->
<svg style="display:none;width:0;height:0;position:absolute;" aria-hidden="true">
  <symbol id="fa-sun" viewBox="0 0 512 512">
    <path fill="currentColor" d="M361.5 1.2c5 2.1 8.6 6.6 9.6 11.9L391 121l107.9 19.8c5.3 1 9.8 4.6 11.9 9.6s1.5 10.7-1.6 15.2L446.9 256l62.3 90.3c3.1 4.5 3.7 10.2 1.6 15.2s-6.6 8.6-11.9 9.6L391 391l-19.9 107.9c-1 5.3-4.6 9.8-9.6 11.9s-10.7 1.5-15.2-1.6L256 446.9l-90.3 62.3c-4.5 3.1-10.2 3.7-15.2 1.6s-8.6-6.6-9.6-11.9L121 391L13.1 371.1c-5.3-1-9.8-4.6-11.9-9.6s-1.5-10.7 1.6-15.2L65.1 256L2.8 165.7c-3.1-4.5-3.7-10.2-1.6-15.2s6.6-8.6 11.9-9.6L121 121l19.9-107.9c1-5.3 4.6-9.8 9.6-11.9s10.7-1.5 15.2 1.6L256 65.1l90.3-62.3c4.5-3.1 10.2-3.7 15.2-1.6M160 256a96 96 0 1 1 192 0a96 96 0 1 1-192 0m224 0a128 128 0 1 0-256 0a128 128 0 1 0 256 0"/>
  </symbol>
  <symbol id="fa-moon" viewBox="0 0 384 512">
    <path fill="currentColor" d="M223.5 32C100 32 0 132.3 0 256s100 224 223.5 224c60.6 0 115.5-24.2 155.8-63.4c5-4.9 6.3-12.5 3.1-18.7s-10.1-9.7-17-8.5c-9.8 1.7-19.8 2.6-30.1 2.6c-96.9 0-175.5-78.8-175.5-176c0-65.8 36-123.1 89.3-153.3c6.1-3.5 9.2-10.5 7.7-17.3s-7.3-11.9-14.3-12.5c-6.3-.5-12.6-.8-19-.8z"/>
  </symbol>
</svg>

<button id="theme-toggle" aria-label="Toggle Theme">
  <svg class="sun-icon"  width="22" height="22" viewBox="0 0 512 512" aria-hidden="true"><use href="#fa-sun" /></svg>
  <svg class="moon-icon" width="22" height="22" viewBox="0 0 384 512" aria-hidden="true"><use href="#fa-moon" /></svg>

  <span class="system-icon" aria-hidden="true">
    <svg class="system-sun"  width="22" height="22" viewBox="0 0 512 512"><use href="#fa-sun" /></svg>
    <svg class="system-moon" width="22" height="22" viewBox="0 0 384 512"><use href="#fa-moon" /></svg>
  </span>
</button>

<style>
  #theme-toggle {
    background: transparent;
    border: none;
    color: var(--color-maintext);
    cursor: pointer;
    padding: 0.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    transition: background-color 0.2s ease;
  }

  #theme-toggle:hover {
    background-color: var(--color-accent);
    color: var(--color-background);
  }

  .sun-icon,
  .moon-icon,
  .system-icon {
    display: none;
  }

  :global([data-theme-mode="light"]) .sun-icon {
    display: block;
  }

  :global([data-theme-mode="dark"]) .moon-icon {
    display: block;
  }

  :global([data-theme-mode="system"]) .system-icon {
    display: inline-flex;
    position: relative;
    width: 22px;
    height: 22px;
  }

  .system-icon .system-sun,
  .system-icon .system-moon {
    position: absolute;
    top: 0;
    left: 0;
  }

  .system-icon .system-sun {
    clip-path: polygon(0 0, 50% 0, 50% 100%, 0 100%);
  }

  .system-icon .system-moon {
    clip-path: polygon(50% 0, 100% 0, 100% 100%, 50% 100%);
  }
</style>

<script>
  function getThemeMode(theme: string): 'dark' | 'light' | 'system' {
    if (theme.endsWith('-dark')) return 'dark';
    if (theme.endsWith('-light')) return 'light';
    if (theme.endsWith('-system')) return 'system';
    return 'dark';
  }

  function getSystemPreference() {
    return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
  }

  function getActualTheme(storedTheme: string) {
    if (storedTheme.endsWith('-system')) {
      return storedTheme.replace('-system', `-${getSystemPreference()}`);
    }
    return storedTheme;
  }

  function applyTheme(theme: string) {
    const actualTheme = getActualTheme(theme);
    document.documentElement.setAttribute('data-theme', actualTheme);
    const mode = theme.endsWith('-system') ? 'system'
               : theme.endsWith('-light') ? 'light' : 'dark';
    document.documentElement.setAttribute('data-theme-mode', mode);
    localStorage.setItem('theme', theme);
    void document.documentElement.offsetHeight;
  }

  const themeToggle = document.getElementById('theme-toggle');

  themeToggle?.addEventListener('click', () => {
    const storedTheme = localStorage.getItem('theme') || 'default-dark';
    const baseTheme = storedTheme.split('-').slice(0, -1).join('-') || 'default';
    const currentMode = getThemeMode(storedTheme);

    // Cycle: light -> dark -> system -> light
    let newMode: 'light' | 'dark' | 'system';
    if (currentMode === 'light') {
      newMode = 'dark';
    } else if (currentMode === 'dark') {
      newMode = 'system';
    } else {
      newMode = 'light';
    }

    applyTheme(`${baseTheme}-${newMode}`);
  });
</script>
