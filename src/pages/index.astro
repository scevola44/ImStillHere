---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/nav.astro";
import Home from "../components/home.astro";
import Tech from "../components/tech.astro";
import Projects from "../components/projects.astro";
import Contact from "../components/contact.astro";
import Resume from "../components/resume.astro";
import type { SupportedLocale } from '../i18n/utils';

import localHomeData from '../data/home.json';
import localResumeData from '../data/resume.json';
import localTechData from '../data/tech.json';

const lang: SupportedLocale = 'en';

const isApiLive = import.meta.env.PROD;
const BASE_URL = import.meta.env.PUBLIC_API_BASE_URL;

let homeData: typeof localHomeData = localHomeData;
let techCategories = localTechData.categories;

if (isApiLive && BASE_URL) {
  try {
    const [homeRes, techRes] = await Promise.all([
      fetch(`${BASE_URL}/home`),
      fetch(`${BASE_URL}/tech`),
    ]);
    if (homeRes.ok) homeData = await homeRes.json();
    if (techRes.ok) {
      const techJson = await techRes.json();
      techCategories = techJson.categories;
    }
  } catch (error) {
    console.error("API Fetch failed, falling back to local data", error);
  }
}

const { webpageTitle } = homeData;
---

<Layout title={webpageTitle} lang={lang}>
  <Nav lang={lang} />
  <Home lang={lang} data={homeData} />
  <Resume lang={lang} resumeData={localResumeData} resumeUrl={homeData.resumeUrl} />
  <Projects lang={lang} />
  <Tech lang={lang} categories={techCategories} />
  <Contact lang={lang} />
</Layout>
